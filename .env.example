# Copy this file to .env in this folder (hw5/.env) and put in your own Portkey key:
#   cp .env.example .env
# Never commit or share the real .env (it's in .gitignore).
PORTKEY_API_KEY=your-portkey-api-key-here
# Optional. The only model allowed in this homework; the backend refuses to start with anything else.
# Use the plain name: prefixed strings like openai/gpt-6-luna fall back to gpt-5.6-luna.
MODEL=gpt-6-luna
